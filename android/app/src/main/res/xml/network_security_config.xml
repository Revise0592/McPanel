<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted panels are often reached over plain HTTP on the home
     network (http://192.168.1.10:8080), so it's allowed. The app warns
     about it when adding such a panel. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
